#!/usr/bin/env python3
"""A stand-in for ewe's ewe-ime (ewe 0.46: typing in other languages), for
the companion's tests: the real one installs and starts fcitx5. `catalog`
lists three languages (Japanese installed, Chinese and Korean not); `add`
and `remove` are logged to ime.log and answered ok. One JSON object, exit 0."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
argv = sys.argv[1:]
with open(os.path.join(D, "ime.log"), "a") as f:
    f.write(json.dumps(argv) + "\n")
cat = [
    {"id": "pinyin", "language": "Chinese", "native": "中文", "method": "Pinyin", "package": "fcitx5-chinese-addons", "glyph": "拼", "installed": False},
    {"id": "mozc", "language": "Japanese", "native": "日本語", "method": "Mozc", "package": "fcitx5-mozc", "glyph": "あ", "installed": True},
    {"id": "hangul", "language": "Korean", "native": "한국어", "method": "Hangul", "package": "fcitx5-hangul", "glyph": "한", "installed": False},
]
if argv[:1] == ["catalog"]:
    print(json.dumps({"ok": True, "catalog": cat}))
elif argv[:1] in (["add"], ["remove"]) and len(argv) == 2:
    print(json.dumps({"ok": True, "engines": [argv[1]] if argv[0] == "add" else []}))
else:
    print(json.dumps({"ok": False, "error": "the fake ewe-ime only knows catalog, add and remove"}))
