#!/usr/bin/env python3
"""A stand-in for ewe's ewe-ime (ewe 0.46: typing in other languages), for
the companion's tests: the real one installs and starts fcitx5. `catalog`
lists three languages in the real one's shape (id, language, native,
method, label, package, glyph, installed, known, core, packages):
Japanese ready, Chinese with fcitx5 but not its engine, Korean not
installed. `add` and `remove` are logged to ime.log and answered like the
real one (its status, plus `did`). One JSON object, exit 0."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
argv = sys.argv[1:]
with open(os.path.join(D, "ime.log"), "a") as f:
    f.write(json.dumps(argv) + "\n")
def entry(eid, lang, native, method, pkg, glyph, installed, core):
    return {"id": eid, "language": lang, "native": native, "method": method,
            "label": lang + " — " + method, "package": pkg, "glyph": glyph,
            "installed": installed, "known": True, "core": core,
            "packages": ([] if core else ["fcitx5", "fcitx5-gtk", "fcitx5-qt", "fcitx5-configtool"])
            + ([] if installed else [pkg])}


cat = [
    entry("pinyin", "Chinese", "中文", "Pinyin", "fcitx5-chinese-addons", "拼", False, True),
    entry("mozc", "Japanese", "日本語", "Mozc", "fcitx5-mozc", "あ", True, True),
    entry("hangul", "Korean", "한국어", "Hangul", "fcitx5-hangul", "한", False, True),
]
if argv[:1] == ["catalog"]:
    print(json.dumps({"ok": True, "catalog": cat}))
elif argv[:1] in (["add"], ["remove"]) and len(argv) == 2:
    print(json.dumps({"ok": True, "enabled": argv[0] == "add",
                      "engines": [argv[1]] if argv[0] == "add" else [], "did": ["prefs", "fcitx5"]}))
else:
    print(json.dumps({"ok": False, "error": "the fake ewe-ime only knows catalog, add and remove"}))
