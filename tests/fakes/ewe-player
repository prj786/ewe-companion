#!/usr/bin/env python3
"""A stand-in for ewe Player, for the companion's tests: Shaun only checks
it is on PATH (the island starts it). Run, it logs its argv to player.log."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
with open(os.path.join(D, "player.log"), "a") as f:
    f.write(json.dumps(sys.argv[1:]) + "\n")
