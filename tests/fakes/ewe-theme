#!/usr/bin/env python3
"""A stand-in for ewe's ewe-theme, for the companion's tests: the real one
repaints the owner's desktop. It answers `scheme list` (Ewe Dark on, or
the slug in $EWE_FAKE_DIR/theme.json) and logs everything else to
theme.log without doing it. One JSON object, exit 0."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
argv = sys.argv[1:]
with open(os.path.join(D, "theme.log"), "a") as f:
    f.write(json.dumps(argv) + "\n")
try:
    cur = json.load(open(os.path.join(D, "theme.json")))["current"]
except (OSError, ValueError, KeyError):
    cur = "ewe-dark"
if argv[:2] == ["scheme", "list"]:
    schemes = [{"slug": "ewe-dark", "name": "Ewe Dark", "variant": "dark", "builtin": True},
               {"slug": "ewe-light", "name": "Ewe Light", "variant": "light", "builtin": True}]
    for s in schemes:
        s["current"] = s["slug"] == cur
    print(json.dumps({"ok": True, "current": cur, "schemes": schemes}))
    sys.exit(0)
print(json.dumps({"ok": False, "error": "fake", "message": "the fake ewe-theme only lists schemes"}))
