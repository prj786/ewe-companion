#!/usr/bin/env python3
"""A stand-in for ffprobe, for the companion's tests (the real one would
need real media files): the streams follow the file's name.
  *.wmv → ASF, Windows Media Video 9 + WMA · *.mkv → MKV, HEVC + DTS
  *.mp4 or an http(s) link ending .mp4 → MP4, H.264 + AAC
  *.flac / *.mp3 → audio only · anything else → an error (not media)
Logs the argv to ffprobe.log."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
argv = sys.argv[1:]
with open(os.path.join(D, "ffprobe.log"), "a") as f:
    f.write(json.dumps(argv) + "\n")
target = argv[-1].lower()
streams = {
    ".wmv": ("asf", [("video", "wmv3"), ("audio", "wmav2")]),
    ".mkv": ("matroska,webm", [("video", "hevc"), ("audio", "dts"), ("subtitle", "subrip")]),
    ".mp4": ("mov,mp4,m4a,3gp,3g2,mj2", [("video", "h264"), ("audio", "aac")]),
    ".flac": ("flac", [("audio", "flac")]),
    ".mp3": ("mp3", [("audio", "mp3")]),
}
for ext, (fmt, ss) in streams.items():
    if target.split("?")[0].endswith(ext):
        print(json.dumps({"streams": [{"codec_type": t, "codec_name": c} for t, c in ss],
                          "format": {"format_name": fmt, "duration": "61.0"}}))
        sys.exit(0)
print("Invalid data found when processing input", file=sys.stderr)
sys.exit(1)
