#!/usr/bin/env python3
"""A stand-in for iproute2's ip, for the companion's tests: only `ip -j
addr`, with a loopback, a Wi-Fi card (one IPv4 and one global IPv6
address) and a link-local address the companion must skip. Anything else
fails like a wrong command. Logs its argv to $EWE_FAKE_DIR/ip.log."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
argv = sys.argv[1:]
with open(os.path.join(D, "ip.log"), "a") as f:
    f.write(json.dumps(argv) + "\n")
if argv == ["-j", "addr"]:
    print(json.dumps([
        {"ifindex": 1, "ifname": "lo", "operstate": "UNKNOWN",
         "addr_info": [{"family": "inet", "local": "127.0.0.1", "prefixlen": 8, "scope": "host"}]},
        {"ifindex": 3, "ifname": "wlan0", "operstate": "UP",
         "addr_info": [{"family": "inet", "local": "192.168.1.23", "prefixlen": 24, "scope": "global"},
                       {"family": "inet6", "local": "2a02:db8::23", "prefixlen": 64, "scope": "global"},
                       {"family": "inet6", "local": "fe80::23", "prefixlen": 64, "scope": "link"}]},
    ]))
    sys.exit(0)
print('Object "%s" is unknown, try "ip help".' % (argv[0] if argv else ""), file=sys.stderr)
sys.exit(1)
