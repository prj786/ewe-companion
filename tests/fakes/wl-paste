#!/usr/bin/env python3
"""A stand-in for wl-paste, for the companion's tests: the real one reads
the owner's clipboard. Prints $EWE_FAKE_DIR/clipboard.txt (nothing, exit 1,
when there is none) and logs the argv and WAYLAND_DISPLAY to wl-paste.log."""
import json
import os
import sys

D = os.environ.get("EWE_FAKE_DIR") or f"/tmp/ewe-companion-fakes-{os.getuid()}"
os.makedirs(D, exist_ok=True)
with open(os.path.join(D, "wl-paste.log"), "a") as f:
    f.write(json.dumps({"argv": sys.argv[1:], "wayland": os.environ.get("WAYLAND_DISPLAY")}) + "\n")
try:
    sys.stdout.write(open(os.path.join(D, "clipboard.txt")).read())
except OSError:
    print("Nothing is copied", file=sys.stderr)
    sys.exit(1)
